{
  "config": {
    "step": {
      "user": {
        "title": "Vividmoo account",
        "description": "App ID and App Key are the official app's request-signing values; they are not included with this integration (see the README for how to get them). Account type, password encoding and API URL are pre-filled with the values the app uses.",
